# Copy this file to `.env` and adjust as needed.
# `.env` itself should NOT be committed to git (see .gitignore).

APP_NAME="Khmer Math Lab API"
APP_VERSION=0.1.0
DEBUG=true

# JSON array of allowed origins. "*" is fine for local development against
# a Flutter app running on an emulator/simulator. Tighten this once you
# have a real deployment domain.
CORS_ORIGINS=["*"]

# aiosqlite for local dev on the M3 Pro. Swap for Postgres later, e.g.:
#   DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/khmer_math_lab
DATABASE_URL=sqlite+aiosqlite:///./khmer_math_lab.db

# Math Vision / OCR Configuration
# Choose provider:
# - "stub"       : Default, no OCR
# - "kiri"       : Recommended native Khmer + English offline OCR (pip install kiri-ocr)
# - "tesseract"  : Traditional open-source OCR (requires tesseract + tesseract-lang)
# - "gemini"     : Google Gemini Vision API (multimodal SOTA for Khmer + English exercises)
# - "mathpix"    : Cloud API, best for complex mathematical formulas
# - "google"     : Google Cloud Vision API
VISION_PROVIDER=stub

# Gemini Vision (if VISION_PROVIDER=gemini)
# Get an API key from https://aistudio.google.com/
# GEMINI_API_KEY=your_gemini_api_key

# Kiri Khmer OCR (if VISION_PROVIDER=kiri or khmer_ocr)
# No additional config needed - weights download on first run (pip install kiri-ocr)

# Mathpix (if VISION_PROVIDER=mathpix)
# Sign up at https://mathpix.com/ to get credentials
# MATHPIX_APP_ID=your_app_id
# MATHPIX_APP_KEY=your_app_key

# Google Cloud Vision (if VISION_PROVIDER=google)
# Download service account JSON from Google Cloud Console
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

