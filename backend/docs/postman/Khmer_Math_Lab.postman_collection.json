          "name": "History - List Past Solved Problems",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/math/history?limit=20&offset=0",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "math", "history"],
              "query": [
                {
                  "key": "limit",
