                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "Returns paginated list of previously solved problems with verification flags."
          }
        },
        {
          "name": "History - Aggregate Statistics",
          "request": {
            "method": "GET",
